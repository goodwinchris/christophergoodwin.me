---
const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/'
    ? pathname === '/'
    : pathname === href || pathname.startsWith(href + '/');
---

<style>
  nav {
    display: flex;
    flex-direction: column;
    position: fixed;
    inline-size: 100vw;
    inset-inline-start: 0;
    text-wrap: nowrap;
    inset-block-start: 0;
    padding: 1.5em;
    background-color: var(--body-background);
    z-index: 1;
    min-inline-size: 106px;
    
    @media (min-width: 500px) {
      inline-size: unset;
      position: sticky;
      padding: 0;
      margin: 0;
      inset-block-start: 50%;
      transform: translateY(-50%);
      margin-inline-end: 3em;
      grid-row: 2 / 3;
      justify-self: end;
    }

    a {
      align-self: start;
    }
  }
</style>


<nav>
  <a href="/" class={isActive('/') ? 'active' : ''}>Home</a>
  <!-- <a href="#" class={isActive('/about') ? 'active' : ''}>About</a> -->
  <!-- <a href="/work" class={isActive('/work') ? 'active' : ''}>Work</a> -->
  <a href="/blog" class={isActive('/blog') ? 'active' : ''}>Blog</a>
  <a href="/photography" class={isActive('/photography') ? 'active' : ''}>Photography</a>
</nav>