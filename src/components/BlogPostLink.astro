---
const {title, url, linkDescription, external} = Astro.props;
---

<style>
  h3 {
    font-weight: 700;
    display: flex;
    gap: 1ch;
  
    svg {
      inline-size: 16px;
      fill: var(--text-color);
    }
  }
</style>

<a href={url} {...(external ? { rel: "noopener noreferrer", target: "_blank" } : {})}>
  <h3>
    {title}
    {external &&
      <p class="visually-hidden">(external)</p>
      <img src="./src/assets/images/external.svg" role="presentation" />
    }
  </h3>
  {linkDescription && <p>{linkDescription}</p>}
</a>