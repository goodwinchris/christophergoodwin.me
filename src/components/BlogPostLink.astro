---
import externalSvg from '../assets/images/external.svg';
const {title, url, linkDescription, external} = Astro.props;
---

<style>
  h3 {
    font-weight: 700;
    display: flex;
    gap: .5ch;
    align-items: baseline;
  
    img {
      inline-size: 14px;
      fill: var(--text-color);
      color: var(--text-color);
    }
  }
</style>

<a href={url} {...(external ? { rel: "noopener noreferrer", target: "_blank" } : {})}>
  <h3>
    {title}
    {external &&
      <p class="visually-hidden">(external)</p>
      <img src={externalSvg.src} role="presentation" />
    }
  </h3>
  {linkDescription && <p>{linkDescription}</p>}
</a>