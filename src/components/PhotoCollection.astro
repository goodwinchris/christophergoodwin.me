---
import imageInfo from '../assets/image-info.json';
const { collectionName } = Astro.props;

const imageModules = import.meta.glob('../assets/photography/*', { eager: true, as: 'url' });

const imageMap = Object.fromEntries(
  Object.entries(imageModules).map(([k, v]) => {
    const parts = k.split('/');
    const name = parts[parts.length - 1];
    return [name, v];
  })
);

const filteredImageList = () => {
  if (!collectionName || collectionName === 'Photo Feed') {
    return imageInfo.toReversed();
  }
  return imageInfo.filter((image) => image.collection === collectionName);
}

const resolveImageUrl = (src: string) => {
  // Try exact basename match first
  const resolvedByName = imageMap[src];
  if (resolvedByName) return resolvedByName;

  // Try matching any glob key that ends with the filename (robust across environments)
  const matchEntry = Object.entries(imageModules).find(([k]) => k.endsWith(`/${src}`) || k.endsWith(src));
  if (matchEntry) return matchEntry[1];

  // Fallback (shouldn't be used in a proper build) — keep original path for dev
  return `/src/assets/photography/${src}`;
}
---
<a class="back-link" href="/photography">
  <span>Back to Photography</span>
</a>
<div>
  <h1>{collectionName}</h1>
  <!-- <p>Photographs from my trip to France.</p> -->
</div>
{filteredImageList().map((img) => (
  <img src={resolveImageUrl(img.src)} loading="lazy" />
))}