---
import type { ImageMetadata } from 'astro';
import imageInfo from '../assets/image-info.json';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/photography/*.{jpg,jpeg,png,JPG,JPEG,PNG}',
  { eager: true }
);

const { collectionName } = Astro.props;
const filteredImages = () => {
  const images = !collectionName || collectionName === 'Photo Feed'
    ? [...imageInfo].reverse()
    : imageInfo.filter((photo) => photo.collection === collectionName);

  return images.map((photo) => {
    const filename = photo.src.split('/').pop();
    const imagePath = `/src/assets/photography/${filename}`;
    const image = imageFiles[imagePath];

    if (!image) {
      console.warn(`No matching asset found for ${imagePath}`);
    }

    return { ...photo, resolved: image?.default };
  }).filter((photo): photo is typeof photo & { resolved: ImageMetadata } => Boolean(photo.resolved));
};
---
<a class="back-link" href="/photography">
  <span>Back to Photography</span>
</a>
<div>
  <h1>{collectionName}</h1>
</div>

{filteredImages().map((photo) => {
  let releaseDate = new Date();
  const [year, month, day] = photo.releaseDate.split('-');
  const todaysDate = new Date();

  releaseDate.setDate(Number(day));
  releaseDate.setFullYear(Number(year));
  releaseDate.setMonth(Number(month) - 1);
  releaseDate.setSeconds(releaseDate.getSeconds() - 1);


  const isAfterToday = releaseDate > todaysDate;
  console.log(releaseDate, todaysDate, isAfterToday);
  if (!isAfterToday) {
      return (
        <img src={photo.resolved.src} alt={photo.alt ? photo.alt : ''} />
      );
    }
  }
)}