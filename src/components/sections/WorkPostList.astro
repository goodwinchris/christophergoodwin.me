---
import { getCollection } from "astro:content";
import BlogPostLink from "../BlogPostLink.astro";

const allPosts = await getCollection("work");

---
{allPosts.toReversed().map((post: any) => (
  <BlogPostLink url={`/work/${post.id}/`} title={post.data.title} linkDescription={post.data.linkDescription}/>
))}