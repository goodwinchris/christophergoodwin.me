---
// import types
import type { ImageCollections } from '../../types/types';
import {imageCollections} from '../../types/types';
---
<style>
    h3 {
      font-weight: 700;
      display: flex;
      gap: .5ch;
      align-items: baseline;
    }
</style>

{
  imageCollections.map((collection: ImageCollections) => (
    <a href={`/photography/${collection.toLowerCase().replace(' ', '-')}`}>
      <h3>{collection}</h3>
    </a>
  ))  
}