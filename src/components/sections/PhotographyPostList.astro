---
import { getCollection } from "astro:content";
import BlogPostLink from "../BlogPostLink.astro";

const allPosts = await getCollection("photography");

---
{allPosts.toSorted((a, b) => a.data.title.localeCompare(b.data.title)).map((post: any) => (
  <BlogPostLink url={`/photography/${post.id}/`} title={post.data.title} linkDescription={post.data.linkDescription}/>
))}