---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import { Font } from "astro:assets";

const currentPath = Astro.url.pathname;

const { pageTitle } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-82639636-1"></script>
    <meta charset="utf-8">
    <title>{pageTitle}</title>
    <meta name="description" content="Building a web that works for everyone, everywhere.">
    <meta name="keywords" content="Chris,Christopher,Goodwin,Web Design,Web Development,Maine,Portland ME,ME,UX,Vermont,VT,User Experience,Developer,remote developer">
    <meta name="author" content="Christopher Goodwin">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/images/favicon.ico" type="image/x-icon">
    <link rel="icon" href="/images/favicon.svg" sizes="any" type="image/svg+xml">
    <Font cssVariable="--font-edmondsans" />
    <script is:inline>
      document.addEventListener("astro:before-swap", (e) => {
        const heads = [document.head, e.newDocument.head];
        for (const head of heads) {
          let idx = 0;
          for (const el of head.querySelectorAll("style")) {
            if (el.textContent.includes("@font-face")) {
              el.setAttribute("data-astro-transition-persist", "font-style-" + idx++);
            }
          }
          for (const link of head.querySelectorAll('link[rel="preload"][as="font"]')) {
            link.setAttribute("data-astro-transition-persist", "font-preload-" + link.getAttribute("href"));
          }
        }
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href={`${currentPath}#mainContent`} data-astro-reload>Skip to main content</a>
    <div class="wrapper">
      <Navigation />
      <main>
        <div class="main__content" id="mainContent" tabindex="-1">
          <slot />
        </div>
      </main>
    </div>
    <!-- Log to console a little art -->
    <script>
       console.log(`%c    ______   ______   _____\n\   /_   _/  /_   _/  /  __/     *        *           *              *\n\    /  /     /  /   /  /_           *             *       *    *\n\   /  /     /  /   /_   /        *         *                           *\n\ _/  /_    /  /   __/  /           *            *        *      *\n\/_____/   /__/   /____/       *          *          *       *       *\n\                                      *         *      *\n\     ________   ___      ___  *      *    *        *               *\n\    /  __   /  /  /     /  /      *         *                 *\n\   /  / /  /  /  /     /  /    *        *          *        *        *\n\  /  /_/  /  /  /     /  /       *           *          *\n\ /  __   /  /  /__   /  /__   *        *           *       *     *\n\/__/ /__/  /_____/  /_____/      *           *           *\n\                                    *         *            *     *\n\     _______    ________   ________   _______    ______    _____\n\    /  ____/   /  __   /  /  __   /  /  __  /   /_   _/   /  __/\n\   /  /       /  / /  /  /  / /  /  /  / /  /    /  /    /  /_\n\  /  / ___   /  / /  /  /  / /  /  /  /  /  /   /  /    /  __/\n\ /  /_/  /  /  /_/  /  /  /_/  /  /  /_/  /   _/  /_   /  /_\n\/_______/  /_______/  /_______/  /______/    /_____/  /____/\n\ `, "font-family:monospace")
    </script>
  </body>
</html>