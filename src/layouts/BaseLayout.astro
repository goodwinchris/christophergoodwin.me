---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';

const { pageTitle } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-82639636-1"></script>
    <meta charset="utf-8">
    <title>{pageTitle}</title>
    <meta name="description" content="Building a web that works for everyone, everywhere.">
    <meta name="keywords" content="Chris,Christopher,Goodwin,Web Design,Web Development,Maine,Portland ME,ME,UX,Vermont,VT,User Experience,Developer,remote developer">
    <meta name="author" content="Christopher Goodwin">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/public/images/favicon.ico" type="image/x-icon">
    <link rel="icon" href="/public/images/favicon.svg" sizes="any" type="image/svg+xml">
  </head>
  <body>
    <div class="wrapper">
      <Navigation />
      <main>
        <div class="main__content">
          <slot />
        </div>
      </main>
    </div>
