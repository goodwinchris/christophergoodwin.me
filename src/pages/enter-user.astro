---
import BaseLayout from '../layouts/BaseLayout.astro';

let error = false;
 
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const user = formData.get('userInput')?.toString() ?? '';
  const redirectTo = formData.get('redirect')?.toString() || '/private';
 
  if (user) {
    Astro.cookies.set('logged-in-as', user, {
      httpOnly: true,
      secure: true,
      sameSite: 'lax',
      path: '/',
      maxAge: 60 * 60 * 24 * 7 * 52, // cookie lasts 1 year
    });
    return Astro.redirect(redirectTo);
  } else {
    error = true;
  }
}
 
const redirectParam = Astro.url.searchParams.get('redirect') || '/private';
---
<style>
  form {
    display: inline-flex;
    flex-direction: column;
    gap: 1.5em;
    align-items: flex-start;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: .25em;
  }

  .label-text {
    order: 1;
  }

  .input {
    order: 2;
    min-width: 50%;
    padding: 0.6em 1em 0.4em;
    border-radius: 6px;
    font-size: 1em;
    border: none;
    border: 1px solid var(--text-color);
    background-color: var(--body-background);
    font-family: var(--font-edmondsans);
    color: var(--text-color);
  }

  .error {
    color: var(--focus-color);
    order: 3;
  }

  .button {
    order: 4;
    padding: 0.7em 1em 0.5em;
    background-color: var(--text-color);
    color: var(--body-background);
    border: none;
    font-family: var(--font-edmondsans);
    font-weight: 700;
    font-size: 1em;
    line-height: 1;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    transition: all .4s ease, transform .4s ease;

    &:hover,
    &:focus,
    &:focus-visible {
      padding: 0.95em 1.25em 0.75em;
      margin: -0.25em -0.25em -0.25em;
    }
  }
</style>
<BaseLayout pageTitle="Enter User | Christopher Goodwin">
  <a class="back-link" href="/photography">
    <span>Back to Photography</span>
  </a>
  <h1>This page requires you to enter your name to see it</h1>
  <p>This is purely for Chris to enjoy who is checking out his work</p>
  <form method="POST">
    {error && <p class="error" aria-live="assertive">You can enter any name, I'd just prefer it to be who you actually are</p>}
    <input type="hidden" name="redirect" value={redirectParam} />
    <label for="userInput">
      <span class="label-text">Your name</span>
      <input
        class="input"
        type="text"
        id="userInput"
        name="userInput"
        required
      />
    </label>
    <button type="submit" class="button">Submit</button>
  </form>
</BaseLayout>
