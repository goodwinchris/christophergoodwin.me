---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoCollection from '../../components/PhotoCollection.astro';
import type { ImageCollections } from '../../types/types';
const collectionName: ImageCollections | 'Photo Feed' = "Photo Feed";
const pageTitle = ` ${collectionName} | Photography | Christopher Goodwin`;
---
<BaseLayout pageTitle={pageTitle}>
  <PhotoCollection collectionName={collectionName} />
</BaseLayout>