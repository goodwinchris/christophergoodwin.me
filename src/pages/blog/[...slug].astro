---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join('/') : slugParam;

if (!slug) {
  throw new Error('Missing slug');
}

const post = await getEntry('blog', slug);

if (!post) {
  throw new Error(`No blog post found for slug: ${slug}`);
}

const { Content } = await render(post);
---

<BaseLayout frontmatter={post.data}  pageTitle={post.data.title + ' | Blog | Christopher Goodwin'}>
  <a class="back-link" href="/blog">
    <span>Back to Blog</span>
  </a>
  <div>
    <time 
      datetime={post.data.pubDate.toLocaleDateString('en-US', {timeZone: 'UTC'})}
    >
      {post.data.pubDate.toLocaleDateString('en-US', {timeZone: 'UTC'})}
    </time>
    <h1>{post.data.title}</h1>
    {post.data.postDescription && (
      <p>{post.data.postDescription}</p>
    )}
  </div>
  <Content />
</BaseLayout>