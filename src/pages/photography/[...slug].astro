---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join('/') : slugParam;

if (!slug) {
  throw new Error('Missing slug');
}

const post = await getEntry('photography', slug);

if (!post) {
  throw new Error(`No photography post found for slug: ${slug}`);
}

const { Content } = await render(post);
---
<BaseLayout frontmatter={post.data} pageTitle={post.data.title + ' | Photography | Christopher Goodwin'}>
  <a class="back-link" href="/photography">
    <span>Back to Photography</span>
  </a>
  <div>
    <h1>{post.data.title}</h1>
    {post.data.postDescription && (
      <p>{post.data.postDescription}</p>
    )}
  </div>
  <Content />
</BaseLayout>