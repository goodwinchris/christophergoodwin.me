---
import BaseLayout from '../layouts/BaseLayout.astro';

let error = false;
 
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const password = formData.get('password')?.toString() ?? '';
  const redirectTo = formData.get('redirect')?.toString() || '/private';
 
  if (password === import.meta.env.SITE_PASSWORD) {
    Astro.cookies.set('site-auth', password, {
      httpOnly: true,
      secure: true,
      sameSite: 'lax',
      path: '/',
      maxAge: 60 * 60 * 24 * 7, // cookie lasts 1 week
    });
    return Astro.redirect(redirectTo);
  } else {
    error = true;
  }
}
 
const redirectParam = Astro.url.searchParams.get('redirect') || '/private';
---
<style>
  form {
    display: inline-flex;
    flex-direction: column;
    gap: 1.5em;
    align-items: flex-start;
  }

  label {
    display: contents;
  }

  .label-text {
    order: 1;
  }

  .input {
    order: 2;
    min-width: 50%;
    padding: 0.5em 1em;
    border-radius: 6px;
    font-size: 1em;
    border: none;
  }

  .error {
    color: var(--focus-color);
    order: 3;
  }

  .button {
    order: 4;
    padding: 0.7em 1em 0.5em;
    background-color: var(--text-color);
    color: var(--body-background);
    border: none;
    font-family: var(--font-edmondsans);
    font-weight: 700;
    font-size: 1em;
    line-height: 1;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    transition: all .4s ease, transform .4s ease;

    &:hover,
    &:focus,
    &:focus-visible {
      padding: 0.95em 1.25em 0.75em;
      margin: -0.25em -0.25em -0.25em;
    }
  }
</style>
<BaseLayout pageTitle="Enter Password | Christopher Goodwin">
  <a class="back-link" href="/work">
    <span>Back to Work</span>
  </a>
  <h1>This page is password protected</h1>
  <form method="POST">
    {error && <p class="error" aria-live="assertive">Incorrect password. Try again.</p>}
    <input type="hidden" name="redirect" value={redirectParam} />
    <label for="password">
      <span class="label-text visually-hidden">Password</span>
      <input
        class="input"
        type="password"
        id="password"
        name="passwordInput"
        required
      />
    </label>
    <button type="submit" class="button">Submit</button>
  </form>
</BaseLayout>
