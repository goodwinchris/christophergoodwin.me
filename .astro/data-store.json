.jpg\">\n\u003Cimg src=\"/public/images/photography/2026-joshua-tree/12.jpg\">\n\u003Cimg src=\"/public/images/photography/2026-joshua-tree/13.jpg\">",{"headings":47,"localImagePaths":48,"remoteImagePaths":49,"frontmatter":50,"imagePaths":54},[],[],[],{"title":37,"pubDate":51,"linkDescription":16,"postDescription":16,"author":17,"image":52,"tags":53},["Date","2026-07-31T00:00:00.000Z"],{"url":16,"alt":16},[9],[],"2026-france",{"id":55,"data":57,"body":62,"filePath":63,"digest":64,"rendered":65},{"title":58,"pubDate":59,"linkDescription":16,"postDescription":16,"author":17,"image":60,"tags":61},"France 2026",["Date","2026-07-31T00:00:00.000Z"],{"url":16,"alt":16},[9],"\u003Cimg src=\"/public/images/photography/2026-france/1.jpg\" />\n\u003Cimg src=\"/public/images/photography/2026-france/2.jpg\" />\n\u003Cimg src=\"/public/images/photography/2026-france/3.jpg\" />\n\u003Cimg src=\"/public/images/photography/2026-france/4.jpg\" />\n\u003Cimg src=\"/public/images/photography/2026-france/5.jpg\" />\n\u003Cimg src=\"/public/images/photography/2026-france/6.jpg\" />\n\u003Cimg src=\"/public/images/photography/2026-france/7.jpg\" />\n\u003Cimg src=\"/public/images/photography/2026-france/8.jpg\" />\n\u003Cimg src=\"/public/images/photography/2026-france/9.jpg\" />\n\u003Cimg src=\"/public/images/photography/2026-france/10.jpg\" />\n\u003Cimg src=\"/public/images/photography/2026-france/11.jpg\" />\n\u003Cimg src=\"/public/images/photography/2026-france/12.jpg\" />\n\u003Cimg src=\"/public/images/photography/2026-france/13.jpg\" />","src/blogs/photography/2026-france.md","fefa2778cd657078",{"html":66,"metadata":67},"\u003Cimg src=\"/public/images/photography/2026-france/1.jpg\">\n\u003Cimg src=\"/public/images/photography/2026-france/2.jpg\">\n\u003Cimg src=\"/public/images/photography/2026-france/3.jpg\">\n\u003Cimg src=\"/public/images/photography/2026-france/4.jpg\">\n\u003Cimg src=\"/public/images/photography/2026-france/5.jpg\">\n\u003Cimg src=\"/public/images/photography/2026-france/6.jpg\">\n\u003Cimg src=\"/public/images/photography/2026-france/7.jpg\">\n\u003Cimg src=\"/public/images/photography/2026-france/8.jpg\">\n\u003Cimg src=\"/public/images/photography/2026-france/9.jpg\">\n\u003Cimg src=\"/public/images/photography/2026-france/10.jpg\">\n\u003Cimg src=\"/public/images/photography/2026-france/11.jpg\">\n\u003Cimg src=\"/public/images/photography/2026-france/12.jpg\">\n\u003Cimg src=\"/public/images/photography/2026-france/13.jpg\">",{"headings":68,"localImagePaths":69,"remoteImagePaths":70,"frontmatter":71,"imagePaths":75},[],[],[],{"title":58,"pubDate":72,"linkDescription":16,"postDescription":16,"author":17,"image":73,"tags":74},["Date","2026-07-31T00:00:00.000Z"],{"url":16,"alt":16},[9],[],"blog",["Map",78,79],"hosting-my-own-blog",{"id":78,"data":80,"body":88,"filePath":89,"digest":90,"rendered":91},{"title":81,"pubDate":82,"linkDescription":83,"postDescription":16,"author":17,"image":84,"tags":85},"Hosting My Own Blog",["Date","2025-11-21T00:00:00.000Z"],"The story of how I got here",{"url":16,"alt":16},[86,87],"web","professional","I’ve been an amateur photographer for a long time. Beginning in high school all the way through today. Looking back on all that time, it seems my cameras have behaved more like good friends than artistic tools; meeting me where I am and allowing that to be enough.\n\nIn the seasons I have been busy, my cameras have waited patiently. In those which I have been creatively drained, they have understood. In those which I have been pursuing other outlets, they have never watched on in envy.\n\nIn the seasons I have needed distraction, they have encouraged me to get outside or go for a drive. In those which I have craved the act of creative pursuit, they have always been excited to go on another adventure.\n\nAll of this to say, when \u003Ca href=\"https://lukejones.me\" target=\"_blank\">my buddy Luke\u003C/a> began expressing interest in picking up film photography, I was excited to help him find his way. I spoke with him about what he was looking for, helped him make some decisions, and lent him a camera which deserved another adventure of its own.\n\nLuke did fall in love with photography and he recently sent me a \u003Ca href=\"https://lukejones.me/shooting-film-2024-2025/\" target=\"_blank\">blog post he’d written about his new found passion\u003C/a>. His link led me to his post. His post lead to admiring his blog. Admiring his blog led to asking more about his tech stack. Asking about his tech stack led to researching \u003Ca href=\"https://astro.build/\" target=\"_blank\">Astro\u003C/a>. And researching Astro led to building my own blog.\n\nThe circle completes.\n\nSo here I am, with a new blog. I am equal parts excited and doubtful. Excited to have my own little corner of the internet to post all I want. Like many of us, I am growing weary of the bottomless well of social media. Doubtful because I fear this outlet may become its own burden over time as well.\n\nHowever, just as my cameras have met me exactly where I have been, I am hopeful this blog will do the same.\n\nEither way, I’m here now and so are you, thanks!","src/blogs/blog/hosting-my-own-blog.md","27275a3b2182448d",{"html":92,"metadata":93},"\u003Cp>I’ve been an amateur photographer for a long time. Beginning in high school all the way through today. Looking back on all that time, it seems my cameras have behaved more like good friends than artistic tools; meeting me where I am and allowing that to be enough.\u003C/p>\n\u003Cp>In the seasons I have been busy, my cameras have waited patiently. In those which I have been creatively drained, they have understood. In those which I have been pursuing other outlets, they have never watched on in envy.\u003C/p>\n\u003Cp>In the seasons I have needed distraction, they have encouraged me to get outside or go for a drive. In those which I have craved the act of creative pursuit, they have always been excited to go on another adventure.\u003C/p>\n\u003Cp>All of this to say, when \u003Ca href=\"https://lukejones.me\" target=\"_blank\">my buddy Luke\u003C/a> began expressing interest in picking up film photography, I was excited to help him find his way. I spoke with him about what he was looking for, helped him make some decisions, and lent him a camera which deserved another adventure of its own.\u003C/p>\n\u003Cp>Luke did fall in love with photography and he recently sent me a \u003Ca href=\"https://lukejones.me/shooting-film-2024-2025/\" target=\"_blank\">blog post he’d written about his new found passion\u003C/a>. His link led me to his post. His post lead to admiring his blog. Admiring his blog led to asking more about his tech stack. Asking about his tech stack led to researching \u003Ca href=\"https://astro.build/\" target=\"_blank\">Astro\u003C/a>. And researching Astro led to building my own blog.\u003C/p>\n\u003Cp>The circle completes.\u003C/p>\n\u003Cp>So here I am, with a new blog. I am equal parts excited and doubtful. Excited to have my own little corner of the internet to post all I want. Like many of us, I am growing weary of the bottomless well of social media. Doubtful because I fear this outlet may become its own burden over time as well.\u003C/p>\n\u003Cp>However, just as my cameras have met me exactly where I have been, I am hopeful this blog will do the same.\u003C/p>\n\u003Cp>Either way, I’m here now and so are you, thanks!\u003C/p>",{"headings":94,"localImagePaths":95,"remoteImagePaths":96,"frontmatter":97,"imagePaths":101},[],[],[],{"title":81,"pubDate":98,"linkDescription":83,"postDescription":16,"author":17,"image":99,"tags":100},["Date","2025-11-21T00:00:00.000Z"],{"url":16,"alt":16},[86,87],[],"work",["Map",104,105],"my-doc-bill",{"id":104,"data":106,"body":111,"filePath":112,"digest":113,"rendered":114},{"title":107,"pubDate":108,"linkDescription":16,"postDescription":16,"author":17,"image":109,"tags":110},"My Doc Bill (Zotec Partners)",["Date","2026-07-31T00:00:00.000Z"],{"url":16,"alt":16},[102],"Hello","src/blogs/work/my-doc-bill.md","3805d20b763ce409",{"html":115,"metadata":116},"\u003Cp>Hello\u003C/p>",{"headings":117,"localImagePaths":118,"remoteImagePaths":119,"frontmatter":120,"imagePaths":124},[],[],[],{"title":107,"pubDate":121,"linkDescription":16,"postDescription":16,"author":17,"image":122,"tags":123},["Date","2026-07-31T00:00:00.000Z"],{"url":16,"alt":16},[102],[]]